{
  "name": "@moralesbuilds/web",
  "version": "1.0.0",
  "description": "Luis Morales' personal website and portfolio product",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "size": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "upload": "opennextjs-cloudflare build && wrangler versions upload",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:cf": "opennextjs-cloudflare build",
    "types": "wrangler types --env-interface CloudflareEnv",
    "test": "cross-env TZ=UTC LANG=en-US vitest run",
    "ts:check": "tsc --noEmit",
    "test:browser": "cross-env TZ=UTC LANG=en-US vitest run --config vitest.browser.config.ts",
    "test:browser:watch": "cross-env TZ=UTC LANG=en-US vitest --config vitest.browser.config.ts --browser.headless=false"
  },
  "keywords": [
    "Portfolio",
    "Personal site"
  ],
  "author": "moralesbuilds",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@moralesbuilds/contents-db": "workspace:*",
    "gray-matter": "^4.0.3",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}