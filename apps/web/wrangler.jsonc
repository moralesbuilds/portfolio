{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "moralesbuilds.dev",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "web"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "web-app-incremental-cache"
    },
    {
      "binding": "BLOG_CONTENTS",
      "bucket_name": "blog-contents"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTENTS_DB",
      "database_name": "contents-db",
      "database_id": "ee75be99-340b-4965-a35f-203eebef7a23",
      "migrations_dir": "../../migrations/contents-db"
    },
    {
      "binding": "METRICS_DB",
      "database_name": "metrics-db",
      "database_id": "5b84c105-474e-4757-a076-65f38f18e772",
      "migrations_dir": "../../migrations/metrics-db"
    }
  ],
  "vars": {
    "APP_EMAIL": "portfolio@moralesbuilds.dev",
    "BASE_URL": "https://moralesbuilds.dev",
    "CONTACT_EMAIL": "luis@moralesbuilds.dev",
    "GITHUB_PORTFOLIO_URL": "https://github.com/moralesbuilds/portfolio",
    "LINKED_IN_URL": "https://www.linkedin.com/in/moralesbuilds",
    "MIN_FORM_FILL_MS": "3000",
    "RATE_LIMIT_MAX_ATTEMPTS": "3",
    "RATE_LIMIT_WINDOW_MS": "600000",
    "X_URL": "https://x.com/moralesbuilds"
  },
  "secrets": {
    "required": [
      "CONTACT_FORM_SALT",
      "TURNSTILE_SECRET",
      "RESEND_API_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}